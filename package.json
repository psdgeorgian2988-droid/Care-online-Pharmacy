{
  "name": "care-online-pharmacy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server/index.mjs",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
    "server": "MEDIHOME_SKIP_BUILD=1 node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "start:prebuilt": "MEDIHOME_SKIP_BUILD=1 node server/index.mjs",
    "lint": "oxlint",
    "test": "node --test src/*.test.mjs",
    "preview": "vite preview",
    "app:sync": "npm run build && npx cap sync",
    "app:android": "npx cap open android",
    "app:ios": "npx cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@vitejs/plugin-react": "^6.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0"
  }
}
