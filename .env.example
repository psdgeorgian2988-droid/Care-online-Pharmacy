# Copy to .env (never commit secrets).
# Razorpay is the payment gateway for UPI, cards, QR, and netbanking.
# Without keys, checkout uses a local test charge. MediHome's split is
# credited in the backend to the settlement bank (not shown on apps).

VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Hosting (one server for website + API)
# PORT=3001
# MEDIHOME_HOST=0.0.0.0
# After npm run build, run: npm start
# Then open http://YOUR-SERVER:3001/  (phone: same Wi-Fi, use the PC's IP)

# Optional staff login override (defaults: admin / MediHome@26)
# MEDIHOME_ADMIN_USER=admin
# MEDIHOME_ADMIN_PASSWORD=MediHome@26

# Partner password-reset and split-update OTP. POST JSON { mobile, text, purpose } to this URL.
# Without it, the OTP is stored but not texted. Verification still works once a code is delivered.
# MEDIHOME_SMS_WEBHOOK=
# Development only: log the OTP and return it as devOtp. Never set this in production.
# MEDIHOME_OTP_DEV=

# Prescription AI uses Cursor (user key from https://cursor.com/dashboard/integrations)
# CURSOR_API_KEY=
# CURSOR_AI_MODEL=composer-2.5


# Phone apps (Capacitor) — API host when UI is bundled inside Android / iOS
# VITE_API_BASE_URL=https://medihome.co.in

# Live reload on a device/emulator (optional; points the app shell at your laptop)
# MEDIHOME_APP_SERVER=http://10.0.2.2:5173
